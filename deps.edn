{:paths ["src" "resources"]
 :deps {org.clojure/clojure {:mvn/version "1.12.0"}
        ring/ring-core {:mvn/version "1.13.0"}
        ring/ring-jetty-adapter {:mvn/version "1.13.0"}
        datascript/datascript {:mvn/version "1.7.3"}
        re-frame/re-frame {:mvn/version "1.4.3"}
        reagent/reagent {:mvn/version "1.2.0"}
        org.babashka/sci {:mvn/version "0.9.44"}
        buddy/buddy-core {:mvn/version "1.12.0"} ; For SHA-256 and SecureRandom
        cljc.java-time/cljc.java-time {:mvn/version "0.1.18"}}

 :aliases
 {:dev {:extra-paths ["test"]
        :extra-deps {org.clojure/test.check {:mvn/version "1.1.1"}
                     thheller/shadow-cljs {:mvn/version "2.28.20"}
                     binaryage/devtools {:mvn/version "1.0.7"}}}
  
  :lint {:extra-deps {clj-kondo/clj-kondo {:mvn/version "2024.11.14"}}
         :main-opts ["-m" "clj-kondo.main" "--lint" "src"]}
  
  :audit {:extra-deps {clj-nvd/clj-nvd {:mvn/version "2.0.0"}}
          :main-opts ["-m" "nvd.task.check" "src"]}
  
  :test {:extra-paths ["test"]
         :extra-deps {lambdaisland/kaocha {:mvn/version "1.91.1392"}}
         :main-opts ["-m" "kaocha.runner"]}
  
  :build {:deps {io.github.clojure/tools.build {:mvn/version "0.10.5"}}
          :ns-default build}}}
